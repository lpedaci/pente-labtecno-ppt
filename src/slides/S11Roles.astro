---
import Slide from '../components/Slide.astro';
const { n } = Astro.props;
const roles = [
  { tone: 't-leaf', icon: 'i-design', who: 'Argüello', role: 'Diseñadora de experiencias de aprendizaje',
    fn: 'Diseño de las dos secuencias de indagación asistida por tecnología, bajo ABP y Diseño Universal para el Aprendizaje',
    with: 'Con el equipo docente de Ciencias Naturales',
    obs: 'Articula la coherencia entre contenido, estrategia y tecnología (TPACK)' },
  { tone: 't-rose', icon: 'i-advice', who: 'Pedaci', role: 'Asesora tecnopedagógica',
    fn: 'Encuadre con los modelos TPACK, ADKAR, lectura de la cultura institucional y acompañamiento del cambio',
    with: 'Con el equipo directivo y el jefe de departamento',
    obs: 'Trabaja las etapas de conciencia y deseo en la devolución del diagnóstico' },
  { tone: 't-rose', icon: 'i-res', who: 'Pedaci', role: 'Gestor de recursos tecnológicos',
    fn: 'Articulación del equipamiento del laboratorio, los dispositivos móviles y el software. Acompaña la elaboración del repositorio institucional y transfiere su gestión al regente de área.',
    with: 'Con el encargado de medios y el área de Ciencias Naturales',
    obs: 'Contempla la relación dispositivos / estudiantes y la organización de los espacios' },
  { tone: 't-amber', icon: 'i-inv', who: 'Costas', role: 'Investigación, actualización y desarrollo',
    fn: 'Relevamiento de antecedentes y marco teórico, sistematización de la documentación',
    with: 'Equipo completo',
    obs: 'Sostiene la revisión bibliográfica y la escritura académica' },
];
---
<Slide n={n} title="Roles y responsabilidades" theme="paper" eyebrow="Roles y responsabilidades"
  heading="Cuatro roles, tres tecnólogas"
  notes="Argüello asume el diseño de experiencias de aprendizaje y articula la coherencia entre contenido, estrategia y tecnología. Pedaci, el asesoramiento tecnopedagógico, que trabaja conciencia y deseo en la devolución del diagnóstico, y la gestión de recursos tecnológicos, que contempla la relación dispositivos / estudiantes y la organización de los espacios. Costas, la investigación, actualización y desarrollo, que sostiene la revisión bibliográfica y la escritura académica.">
  <div class="grid">
    {roles.map((r, k) => (
      <article class:list={['panel role', r.tone]} data-a style={`--i:${k + 2}`}>
        <div class="top">
          <svg class="ico" aria-hidden="true"><use href={`#${r.icon}`}/></svg>
          <div>
            <span class="who">{r.who}</span>
            <h3>{r.role}</h3>
          </div>
        </div>
        <p class="sm">{r.fn}</p>
        <p class="meta"><span>Interacción</span>{r.with}</p>
      </article>
    ))}
  </div>
</Slide>

<style>
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;height:100%}
  .role{display:flex;flex-direction:column;gap:14px;padding:24px 28px;border-top:5px solid var(--tone)!important;box-shadow:0 18px 40px -26px rgba(18,58,44,.35);--tone:var(--leaf);--tone-ink:var(--leaf-ink)}
  .role.t-rose{--tone:var(--rose);--tone-ink:var(--rose-deep)}
  .role.t-amber{--tone:var(--amber);--tone-ink:#7A5310}
  .top{display:flex;gap:18px;align-items:center}
  .top .ico{color:var(--tone-ink)}
  .who{font-family:var(--mono);font-size:var(--xs);letter-spacing:.1em;text-transform:uppercase;color:var(--tone-ink);font-weight:600}
  h3{color:var(--ink);margin-top:2px}
  .role>p:not(.meta){font-size:var(--sm)}
  .meta{margin-top:auto;padding-top:14px;border-top:1px solid var(--line);font-size:calc(var(--xs)*1.1);line-height:1.4;color:var(--muted)}
  .meta span{font-family:var(--mono);font-size:11.5px;text-transform:uppercase;letter-spacing:.1em;color:var(--tone-ink);margin-right:10px}
  :global(body.m-scroll) .grid{grid-template-columns:1fr}
</style>
