---
import Slide from '../components/Slide.astro';
const { n } = Astro.props;
const steps = [
  { t: 'Prueba piloto', d: 'Un curso y un docente, con los indicadores previstos.' },
  { t: 'Condiciones institucionales', d: 'Aval, horas y elevación de la revisión del acuerdo de convivencia.' },
  { t: 'Secuencias con protagonismo estudiantil', d: 'Celular regulado, roles y producciones editadas y compartidas por los estudiantes.' },
  { t: 'Instrumentos de evaluación', d: 'Cuestionario TPACK posterior, rúbrica ADKAR y grupo focal.' },
];
const repo = [
  'Opciones: canal de Teams, sitio en GitHub Pages, Padlet o Canva',
  'Criterio prioritario: que los docentes puedan actualizarlo sin depender del tecnólogo educativo',
  'Las producciones con imágenes de estudiantes quedan en el entorno del curso',
  'Al cierre, su gestión pasa al regente de área',
];
---
<Slide n={n} title="Próximos pasos" theme="paper" eyebrow="Hacia la implementación"
  heading="Próximos pasos"
  bodyClass="cols c-46"
  notes="El repositorio nace de una práctica que ya existe: el mensaje fijado en Microsoft Teams. No imponemos una herramienta nueva. La plataforma se elige con el equipo docente según el diagnóstico, y el criterio que manda es que la institución pueda sostenerlo sola: el repositorio tiene que quedar como capacidad instalada. En términos de ADKAR, es el mecanismo de refuerzo.">
  <ol class="steps">
    {steps.map((s, k) => (
      <li data-a style={`--i:${k + 2}`}>
        <span class="k">{String(k + 1).padStart(2, '0')}</span>
        <div><h3>{s.t}</h3><p class="sm">{s.d}</p></div>
      </li>
    ))}
  </ol>
  <section class="repo" data-a style="--i:3" aria-labelledby="repo-title">
    <span class="eyebrow">Repositorio institucional</span>
    <h3 id="repo-title">Del mensaje fijado a un repositorio organizado</h3>
    <p class="sm">El mensaje fijado en Microsoft Teams se mantiene como puerta de acceso a un repositorio organizado por año, por secuencia y por tipo de recurso. La plataforma se define con el equipo docente a partir del diagnóstico (fases 2 y 3):</p>
    <ul class="clean">
      {repo.map((r) => <li>{r}</li>)}
    </ul>
  </section>
</Slide>

<style>
  .steps{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
  .steps li{display:grid;grid-template-columns:64px 1fr;gap:16px;align-items:start;padding:20px 0;border-top:1px solid var(--line)}
  .steps li:first-child{border-top:0;padding-top:0}
  .k{font-family:var(--mono);font-size:calc(var(--h3)*.9);color:var(--rose);font-weight:600;line-height:1.2}
  .steps h3{font-size:var(--h3);font-weight:700;margin-bottom:6px}
  .steps p{color:var(--muted)}
  .repo{display:flex;flex-direction:column;gap:14px;background:#fff;border:1px solid var(--line);border-top:5px solid var(--rose);border-radius:16px;padding:28px 32px;box-shadow:0 18px 40px -26px rgba(18,58,44,.35)}
  .repo .eyebrow{color:var(--rose-deep)}
  .repo h3{font-size:calc(var(--h3)*1.1);font-weight:800}
  .repo .clean{margin-top:4px}
  .repo .clean li{font-size:var(--sm)}
</style>
