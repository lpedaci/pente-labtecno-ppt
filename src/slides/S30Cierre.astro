---
import Slide from '../components/Slide.astro';
import Cover from '../components/Cover.astro';
const { n } = Astro.props;
---
<Slide n={n} title="Cierre" theme="dark" hex bare
  notes="Cerramos volviendo a la portada: de la prohibición del celular al laboratorio ampliado. El celular deja de ser un objeto prohibido para convertirse en un instrumento del laboratorio, siempre que el diseño didáctico le asigne una función y un protocolo regule su uso. Gracias.">
  <Cover uid="cierre" />
</Slide>
