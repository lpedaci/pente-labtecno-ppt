---
import Slide from '../components/Slide.astro';
import Cover from '../components/Cover.astro';
const { n } = Astro.props;
---
<Slide n={n} title="Portada" theme="dark" hex bare
  notes="Presentamos la Actividad Obligatoria 4: la sistematización de la intervención tecnopedagógica diseñada en el primer parcial. El título resume el giro de la propuesta: pasar de prohibir el celular a integrarlo, con funciones definidas, como instrumento del laboratorio.">
  <Cover uid="portada" />
</Slide>
