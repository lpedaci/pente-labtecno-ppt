---
import Deck from '../layouts/Deck.astro';
import S01 from '../slides/S01Portada.astro';
import S02 from '../slides/S02Introduccion.astro';
import S03 from '../slides/S03Objetivos.astro';
import S04 from '../slides/S04Metodologia.astro';
import S06 from '../slides/S06Normativo.astro';
import S09 from '../slides/S09Fases.astro';
import S11 from '../slides/S11Roles.astro';
import S12 from '../slides/S12Bitacora.astro';
import S14 from '../slides/S14Espacios.astro';
import S15 from '../slides/S15Numeros.astro';
import S18 from '../slides/S18Hallazgo.astro';
import S19 from '../slides/S19Accesibilidad.astro';
import S22 from '../slides/S22Sistematizacion.astro';
import S23 from '../slides/S23Proximos.astro';
import S23b from '../slides/S23bPlataformas.astro';
import S24 from '../slides/S24Reflexiones.astro';
import S27 from '../slides/S27Anexo.astro';
import S29 from '../slides/S29Referencias.astro';
import S30 from '../slides/S30Cierre.astro';

// Recorrido de la exposición (15 minutos): problema, caso análogo, análisis, propuesta y aplicación.
const slides = [
  S01, S02, S03, S04, S06,          // punto de partida: problema, objetivos, metodología y marco normativo
  S14, S15, S19, S12, S18, S22,     // el caso análogo: espacios, números, accesibilidad, bitácora, hallazgo y análisis
  S09, S11,                         // la propuesta
  S23, S27, S23b,                   // aplicación: próximos pasos, cuestionarios y plataformas
  S24, S29, S30,                    // reflexión, referencias y cierre
];
---
<Deck
  title="Laboratorio Ampliado · Actividad 4"
  description="Sistematización de la intervención tecnopedagógica: de la prohibición del celular al laboratorio ampliado en una escuela secundaria técnica. UTN, Prácticas en Tecnología Educativa, Grupo 3, 2026."
  total={slides.length}
>
  {slides.map((S, i) => <S n={i + 1} />)}
</Deck>
